# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and must be tracked.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling — local to whoever is working on this, not project code.
# NB: a leading "./" is not a valid gitignore pattern and silently matches nothing,
# which is how skills-lock.json ended up tracked.
/skills-lock.json
.claude/
.agents/
.mcp.json

# Planning/spec docs — working notes, kept local rather than published.
/docs/
