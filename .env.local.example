# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Random 32+ chars. Mixed into anonymous token hashing.
IDENTITY_PEPPER=

# Server-only. Seeds the owner admin row on first setup.
OWNER_SECRET=

# Optional. The public origin THIS web app hands out, e.g. https://chat.pranabkr.in.
# /agent prints it into the agent URL and the editor configs; without it the page falls
# back to the request's own host, which prints http://localhost:3000 on a local build.
# Not the same variable as HITCHAT_URL: that one lives on a user's machine and tells the
# CLI/MCP package where to send requests. Same value, different side of the wire.
SITE_URL=
