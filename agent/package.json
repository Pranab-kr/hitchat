{
  "name": "@pranabkr/hitchat-agent",
  "version": "0.1.2",
  "description": "CLI and local MCP server for hitchat, the anonymous self-destructing lab chat.",
  "license": "MIT",
  "homepage": "https://chat.pranabkr.in/agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranab-kr/hitchat.git",
    "directory": "agent"
  },
  "keywords": [
    "hitchat",
    "mcp",
    "mcp-server",
    "cli",
    "anonymous-chat",
    "lab"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hitchat": "./dist/cli.js",
    "hitchat-mcp": "./dist/mcp.js",
    "hitchat-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "pack:dry": "bun run build && bun pm pack --dry-run",
    "prepublishOnly": "bun run build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^14.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsdown": "^0.18.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
